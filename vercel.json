{
  "git": { "productionBranch": "vercel-free" },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.nhadat.ai.vn" }],
      "destination": "https://nhadat.ai.vn/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|.*\\.).*)", "destination": "/" }
  ],
  "headers": [
    { "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
