{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://nhadat.ai.vn/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "emyland.vn" }]
    }
  ],

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
